{
	"name": "opencub-vscode",
	"displayName": "OpenCub",
	"description": "VS Code integration for OpenCub - local-first AI coding assistant",
	"version": "0.3.0",
	"publisher": "BitopiaLabs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BitopiaLabs/Opencub.git"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Programming Languages",
		"Machine Learning",
		"Other"
	],
	"keywords": [
		"ai",
		"coding",
		"assistant",
		"opencub",
		"ollama",
		"local"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"icon": "media/icon.png",
	"contributes": {
		"commands": [
			{
				"command": "opencub.connect",
				"title": "Connect to OpenCub",
				"category": "OpenCub"
			},
			{
				"command": "opencub.disconnect",
				"title": "Disconnect from OpenCub",
				"category": "OpenCub"
			},
			{
				"command": "opencub.startCli",
				"title": "Start OpenCub CLI",
				"category": "OpenCub"
			}
		],
		"configuration": {
			"title": "OpenCub",
			"properties": {
				"opencub.serverPort": {
					"type": "number",
					"default": 51820,
					"description": "WebSocket server port for communication with OpenCub CLI"
				},
				"opencub.autoConnect": {
					"type": "boolean",
					"default": true,
					"description": "Automatically connect to OpenCub CLI on startup"
				},
				"opencub.autoStartCli": {
					"type": "boolean",
					"default": false,
					"description": "Automatically start OpenCub CLI if not running"
				},
				"opencub.showDiffPreview": {
					"type": "boolean",
					"default": true,
					"description": "Show diff preview before applying file changes"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "pnpm run build",
		"build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
		"watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
		"lint": "eslint src --ext ts"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"@types/vscode": "^1.85.0",
		"@types/ws": "^8.5.10",
		"@vscode/vsce": "^3.7.0",
		"esbuild": "^0.28.0",
		"eslint": "^10.1.0",
		"typescript": "^5.3.0"
	},
	"dependencies": {
		"ws": "^8.16.0"
	}
}
